{
  "name": "my-hades",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Headless deterministic action-roguelike simulation core (Hades-like), logic fully decoupled from rendering.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "pixi.js": "^8.21.0"
  }
}
